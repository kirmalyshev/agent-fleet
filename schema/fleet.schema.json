        },
        "tasks": {
          "additionalProperties": {
            "$ref": "#/$defs/Task"
          },
          "type": "object"
        },
        "unknown": {
          "description": "Events this binary cannot fold (an unknown type, or a known type at a newer `v`): kept in\nthe log, skipped here.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "worktree_procs": {
          "additionalProperties": {
            "$ref": "#/$defs/Procs"
          },
          "description": "Processes running in worktrees (or orphaned beside them) by `<host>:<path>`.",
