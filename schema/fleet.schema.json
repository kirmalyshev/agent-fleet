          "additionalProperties": false,
          "description": "Processes running in a worktree that no agent's process tree holds: dev servers, databases,\ntest runs, shells. Sent each scan while there are any, then once with `procs: 0`.",
          "properties": {
            "cpu_pct": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "host": {
              "type": "string"
            },
            "names": {
              "description": "Distinct process names, at most 8.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "orphaned": {
              "description": "The directory is gone: nothing that could stop these processes knows they are there.",
              "type": "boolean"
            },
            "path": {
              "type": "string"
