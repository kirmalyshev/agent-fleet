          "properties": {
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty": {
              "description": "Modified and untracked files.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "files": {
              "description": "Files changed against the default branch, plus dirty ones; at most `MAX_FILES`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "head": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "last_commit": {
              "format": "date-time",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "repo": {
              "description": "The main checkout the worktree belongs to.",
              "type": "string"
            },
            "unpushed": {
              "description": "Commits on HEAD that no remote has.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "host",
            "path",
            "repo",
            "head",
            "unpushed",
            "dirty",
            "files",
            "last_commit"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "agents": {
          "additionalProperties": {
            "$ref": "#/$defs/Agent"
          },
          "type": "object"
        },
        "asks": {
          "additionalProperties": {
            "$ref": "#/$defs/Ask"
          },
          "description": "Open asks by the id of their `ask.raised`.",
          "type": "object"
        },
        "blockers": {
          "additionalProperties": {
            "$ref": "#/$defs/Blocker"
          },
          "description": "Open blockers by the id of their `blocker.raised`.",
          "type": "object"
        },
        "hosts": {
          "additionalProperties": {
            "$ref": "#/$defs/Host"
          },
          "type": "object"
        },
