            "pids": {
              "description": "At most 20.",
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "procs": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "rss_kb": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
