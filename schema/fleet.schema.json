{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "protocol": 1,
  "schema_version": 1,
  "schemas": {
    "event": {
      "$defs": {
        "Actor": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "description": "`agent:<host>/<session>/<name>`, `host:<name>`, `human:<handle>`.",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/ActorKind"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        "ActorKind": {
          "enum": [
            "agent",
            "human",
            "host",
            "hub"
          ],
          "type": "string"
        },
        "AgentDown": {
          "additionalProperties": false,
          "properties": {
            "agent": {
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "agent"
          ],
          "type": "object"
        },
        "AgentState": {
          "description": "An agent's lifecycle state, as the terminal multiplexer reports it.",
          "enum": [
            "idle",
            "working",
            "blocked",
            "done",
            "unknown"
          ],
          "type": "string"
        },
        "AgentStateChanged": {
          "additionalProperties": false,
          "properties": {
            "agent": {
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/AgentState"
            }
          },
          "required": [
            "agent",
            "state"
          ],
          "type": "object"
        },
        "AgentUp": {
          "additionalProperties": false,
          "properties": {
            "agent": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "kind": {
              "description": "Agent program, e.g. `claude`.",
              "type": [
                "string",
                "null"
              ]
            },
            "pane": {
              "description": "Multiplexer pane currently hosting the agent.",
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "$ref": "#/$defs/AgentState"
            }
          },
          "required": [
            "agent",
            "host",
            "state"
          ],
          "type": "object"
        },
        "AgentUsage": {
          "additionalProperties": false,
          "description": "What an agent's processes cost: the pane's whole process tree, sampled by its host.",
          "properties": {
            "agent": {
              "type": "string"
            },
            "cpu_pct": {
              "description": "CPU since the previous sample, in percent of one core.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "cwd": {
              "description": "Where the agent works.",
              "type": [
                "string",
                "null"
              ]
            },
            "procs": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "rss_kb": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "agent",
            "rss_kb",
            "cpu_pct",
            "procs"
          ],
          "type": "object"
        },
        "AskRaised": {
          "additionalProperties": false,
          "properties": {
            "context": {
              "description": "A link to the context needed to answer.",
              "type": [
                "string",
                "null"
              ]
            },
            "options": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "question": {
              "type": "string"
            },
            "recommendation": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "question"
          ],
          "type": "object"
        },
        "BlockerRaised": {
          "additionalProperties": false,
          "properties": {
            "owner": {
              "description": "Who or what has to act: an agent, a resource, an ask.",
              "type": [
                "string",
                "null"
              ]
            },
            "unblocks_when": {
              "type": [
                "string",
                "null"
              ]
            },
            "what": {
              "type": "string"
            }
          },
          "required": [
            "what"
          ],
          "type": "object"
        },
        "BlockerResolved": {
          "additionalProperties": false,
          "description": "Resolves the `blocker.raised` named by the envelope's `re`.",
          "properties": {
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "Dep": {
          "additionalProperties": false,
          "description": "`task` is blocked by `on`.",
          "properties": {
            "on": {
              "type": "string"
            }
          },
          "required": [
            "on"
          ],
          "type": "object"
        },
        "Handoff": {
          "additionalProperties": false,
          "properties": {
            "done": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "description": "Persistent paths or links.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "learned": {
              "type": [
                "string",
                "null"
              ]
            },
            "next": {
              "description": "The exact next step.",
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "to",
            "next"
          ],
          "type": "object"
        },
        "HostHealth": {
          "additionalProperties": false,
          "properties": {
            "agents": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "disk_free": {
              "description": "Bytes available to unprivileged users on the fleet data volume.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "disk_total": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "host": {
              "type": "string"
            },
            "stats": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HostStats"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "host",
            "disk_free",
            "disk_total",
            "agents"
          ],
          "type": "object"
        },
        "HostStats": {
          "additionalProperties": false,
          "description": "The host agent's own vitals. Counters run from the host's start, so a drop in `uptime_s`\nbetween two reports is a restart.",
          "properties": {
            "cpu_ms": {
              "description": "User + system CPU time of the host process.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "herdr_errors": {
              "description": "Failed herdr calls and dropped herdr subscriptions.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "max_rss_kb": {
              "description": "Peak resident memory of the host process.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "ring_failures": {
              "description": "Rings that failed or were not followed by `working`.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "rings": {
              "description": "Doorbells typed into an agent.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "spooled": {
              "description": "Events this host sent to the spool instead of the hub.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "uptime_s": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "write_failures": {
              "description": "Events this host could neither send nor spool.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "uptime_s",
            "max_rss_kb",
            "cpu_ms",
            "rings",
            "ring_failures",
            "herdr_errors",
            "write_failures",
            "spooled"
          ],
          "type": "object"
        },
        "MsgDelivered": {
          "additionalProperties": false,
          "description": "The `msg.sent` named by `re` reached the agent, which then turned `observed`.",
          "properties": {
            "attempts": {
              "description": "Rings it took, this one included.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "observed": {
              "$ref": "#/$defs/AgentState"
            },
            "rung": {
              "description": "When the ring that worked was typed.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "to",
            "observed"
          ],
          "type": "object"
        },
        "MsgSent": {
          "additionalProperties": false,
          "description": "A doorbell: a short prompt pointing at an event or a task.",
          "properties": {
            "kind": {
              "description": "What the recipient should do, e.g. `REVIEW`, `FYI`, `UNBLOCKED`.",
              "type": "string"
            },
            "ref": {
              "description": "The event or task the message is about.",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "to",
            "kind",
            "ref",
            "text"
          ],
          "type": "object"
        },
        "TaskAssigned": {
          "additionalProperties": false,
          "properties": {
            "agent": {
              "type": "string"
            },
            "lead": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "agent"
          ],
          "type": "object"
        },
        "TaskCreated": {
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "url": {
              "description": "Where the spec lives (an issue, a doc).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "title"
          ],
          "type": "object"
        },
        "TaskState": {
          "description": "Task lifecycle, aligned with the A2A task states.",
          "enum": [
            "submitted",
            "working",
            "input-required",
            "completed",
            "failed",
            "canceled"
          ],
          "type": "string"
        },
        "TaskStateChanged": {
          "additionalProperties": false,
          "properties": {
            "state": {
              "$ref": "#/$defs/TaskState"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        "TaskUnassigned": {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "WorktreeGone": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "host",
            "path"
          ],
          "type": "object"
        },
        "WorktreeProcs": {
          "additionalProperties": false,
          "description": "Processes running in a worktree that no agent's process tree holds: dev servers, databases,\ntest runs, shells. Sent each scan while there are any, then once with `procs: 0`.",
          "properties": {
            "cpu_pct": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "host": {
              "type": "string"
            },
            "names": {
              "description": "Distinct process names, at most 8.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "orphaned": {
              "description": "The directory is gone: nothing that could stop these processes knows they are there.",
              "type": "boolean"
            },
            "path": {
              "type": "string"
            },
            "pids": {
              "description": "At most 20.",
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "procs": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "rss_kb": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "host",
            "path",
            "procs",
            "rss_kb",
            "cpu_pct",
            "names",
            "pids",
            "orphaned"
          ],
          "type": "object"
        },
        "WorktreeState": {
          "additionalProperties": false,
          "description": "A git worktree on a host, as its last scan found it. Sent when it changes.",
          "properties": {
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty": {
              "description": "Modified and untracked files.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "files": {
              "description": "Files changed against the default branch, plus dirty ones; at most `MAX_FILES`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "head": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "last_commit": {
              "format": "date-time",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "repo": {
              "description": "The main checkout the worktree belongs to.",
              "type": "string"
            },
            "unpushed": {
              "description": "Commits on HEAD that no remote has.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "host",
            "path",
            "repo",
            "head",
            "unpushed",
            "dirty",
            "files",
            "last_commit"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Every event: the envelope fields plus a `type` tag and its `data`.",
      "oneOf": [
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/AgentUp"
            },
            "type": {
              "const": "agent.up",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/AgentStateChanged"
            },
            "type": {
              "const": "agent.state",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/AgentDown"
            },
            "type": {
              "const": "agent.down",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/HostHealth"
            },
            "type": {
              "const": "host.health",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/AgentUsage"
            },
            "type": {
              "const": "agent.usage",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/WorktreeState"
            },
            "type": {
              "const": "worktree.state",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/WorktreeGone"
            },
            "type": {
              "const": "worktree.gone",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/WorktreeProcs"
            },
            "type": {
              "const": "worktree.procs",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/TaskCreated"
            },
            "type": {
              "const": "task.created",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/TaskAssigned"
            },
            "type": {
              "const": "task.assigned",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/TaskUnassigned"
            },
            "type": {
              "const": "task.unassigned",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/TaskStateChanged"
            },
            "type": {
              "const": "task.state",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/Dep"
            },
            "type": {
              "const": "task.dep.added",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/Dep"
            },
            "type": {
              "const": "task.dep.removed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/BlockerRaised"
            },
            "type": {
              "const": "blocker.raised",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/BlockerResolved"
            },
            "type": {
              "const": "blocker.resolved",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/AskRaised"
            },
            "type": {
              "const": "ask.raised",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/MsgSent"
            },
            "type": {
              "const": "msg.sent",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/MsgDelivered"
            },
            "type": {
              "const": "msg.delivered",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/Handoff"
            },
            "type": {
              "const": "handoff",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "id": {
          "description": "ULID chosen by the writer. Appending the same id twice is a no-op.",
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "re": {
          "description": "The event this one answers or follows.",
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "ts": {
          "format": "date-time",
          "type": "string"
        },
        "v": {
          "description": "Schema version of this event's type.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "v",
        "ts",
        "actor",
        "project"
      ],
      "title": "Event",
      "type": "object"
    },
    "state": {
      "$defs": {
        "Agent": {
          "properties": {
            "host": {
              "type": "string"
            },
            "kind": {
              "type": [
                "string",
                "null"
              ]
            },
            "pane": {
              "type": [
                "string",
                "null"
              ]
            },
            "since": {
              "format": "date-time",
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/AgentState"
            },
            "usage": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Usage"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "host",
            "state",
            "since"
          ],
          "type": "object"
        },
        "AgentState": {
          "description": "An agent's lifecycle state, as the terminal multiplexer reports it.",
          "enum": [
            "idle",
            "working",
            "blocked",
            "done",
            "unknown"
          ],
          "type": "string"
        },
        "Ask": {
          "properties": {
            "by": {
              "type": "string"
            },
            "context": {
              "type": [
                "string",
                "null"
              ]
            },
            "options": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "question": {
              "type": "string"
            },
            "recommendation": {
              "type": [
                "string",
                "null"
              ]
            },
            "since": {
              "format": "date-time",
              "type": "string"
            },
            "task": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "by",
            "question",
            "options",
            "since"
          ],
          "type": "object"
        },
        "Blocker": {
          "properties": {
            "by": {
              "type": "string"
