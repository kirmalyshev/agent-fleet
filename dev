#!/bin/sh
# Developer helpers for this repository.
#
#   ./dev ls               every worktree of this repo: branch, PR, commits not in main,
#                          uncommitted files, whether a process runs in it, what clean does
#   ./dev clean            what clean would retire and delete (a dry run)
#   ./dev clean --execute  retire stale worktrees and delete stale local branches
#
# A local branch is stale when its tip is safe somewhere else:
#   in main   the tip is an ancestor of origin/main
#   pr        one of your merged or closed PRs has this exact tip as its head
#   pushed    origin/<branch> contains the tip
# A branch with an open PR is never stale, and local-only commits are never deleted. Only "pr"
# retires a worktree (a worktree just made off main is "in main" too). A worktree is kept when it
# is the main checkout, the one you are in, has uncommitted changes, or a process runs in it
# (an agent's pane). `gh` (GH overrides it) finds the PRs; without it only the git checks apply.
set -eu

GH=${GH:-gh}
main_root=$(git rev-parse --path-format=absolute --git-common-dir)
main_root=$(dirname "$main_root")
here=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

die() { echo "dev: $*" >&2; exit 1; }
g() { git -C "$main_root" "$@"; }

# Your PRs, one per line: branch state tip number.
prs() {
	if ! "$GH" pr list --state all --author @me --limit 1000 \
		--json headRefName,state,headRefOid,number \
		--jq '.[] | "\(.headRefName) \(.state) \(.headRefOid) \(.number)"' >"$tmp/prs" 2>/dev/null; then
		echo "dev: gh unavailable, PR checks skipped" >&2
		: >"$tmp/prs"
	fi
}

# Every process's working directory, one per line (lsof works on Linux and macOS).
cwds() { lsof -a -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | sort -u >"$tmp/cwds" || : >"$tmp/cwds"; }

# Why <branch> at <tip> is safe to delete; empty to keep it.
stale_reason() {
	if awk -v b="$1" '$1 == b && $2 == "OPEN" { f = 1 } END { exit !f }' "$tmp/prs"; then
		return
	fi
	if g merge-base --is-ancestor "$2" origin/main 2>/dev/null; then
		echo "in main"
	elif awk -v b="$1" -v t="$2" '$1 == b && $3 == t { f = 1 } END { exit !f }' "$tmp/prs"; then
		echo "pr"
	elif g rev-parse -q --verify "refs/remotes/origin/$1" >/dev/null &&
		g merge-base --is-ancestor "$2" "origin/$1" 2>/dev/null; then
		echo "pushed"
	fi
}

# Why the worktree at <path> must stay; empty when it may go.
blocked() {
	[ "$1" = "$main_root" ] && { echo "main checkout"; return; }
	case "$here/" in "$1"/*) echo "you are in it"; return ;; esac
	[ -d "$1" ] || return 0
	[ -z "$(git -C "$1" status --porcelain 2>/dev/null)" ] || { echo "uncommitted changes"; return; }
	if awk -v p="$1" '$0 == p || index($0, p "/") == 1 { f = 1 } END { exit !f }' "$tmp/cwds"; then
		echo "a process runs in it"
	fi
}

# Worktrees as lines: path<TAB>branch (branch empty when detached).
worktrees() {
	g worktree list --porcelain | awk '
		/^worktree / { if (p != "") print p "\t" b; p = substr($0, 10); b = "" }
		/^branch / { b = substr($0, 8); sub("^refs/heads/", "", b) }
		END { if (p != "") print p "\t" b }'
}

cmd_ls() {
	g fetch origin --prune --quiet || echo "dev: fetch failed, origin may be stale" >&2
	prs
	cwds
	printf '%-28s %-14s %5s %5s %-4s %-26s %s\n' BRANCH PR AHEAD DIRTY RUN CLEAN WORKTREE
	worktrees | while IFS="$(printf '\t')" read -r path branch; do
		pr=- ahead=- dirty=- run=- verdict=-
		if [ -n "$branch" ]; then
			pr=$(awk -v b="$branch" '$1 == b { print "#" $4 " " tolower($2); exit }' "$tmp/prs")
			[ -n "$pr" ] || pr=-
			ahead=$(g rev-list --count "origin/main..$branch" 2>/dev/null || echo "?")
		fi
		if [ -d "$path" ]; then
			dirty=$(git -C "$path" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
			awk -v p="$path" '$0 == p || index($0, p "/") == 1 { f = 1 } END { exit !f }' "$tmp/cwds" &&
				run=yes || run=no
		else
			verdict="gone: prune"
		fi
		if [ -d "$path" ] && [ -n "$branch" ]; then
			reason=$(stale_reason "$branch" "$(g rev-parse "$branch")")
			why=$(blocked "$path")
			if [ "$reason" = "pr" ] && [ -z "$why" ]; then
				verdict="retire (pr)"
			elif [ -n "$reason" ] && [ -n "$why" ]; then
				verdict="keep: $why"
			elif [ -n "$reason" ]; then
				verdict="keep ($reason)"
			fi
		fi
		printf '%-28s %-14s %5s %5s %-4s %-26s %s\n' "$branch" "$pr" "$ahead" "$dirty" "$run" "$verdict" "$path"
	done
}

cmd_clean() {
	execute=
	case "${1:-}" in
		"") ;;
		--execute) execute=1 ;;
		*) die "usage: ./dev clean [--execute]" ;;
	esac
	g fetch origin --prune --quiet || die "fetch failed; nothing done"
	prs
	cwds
	: >"$tmp/retire"
	: >"$tmp/out"
	worktrees >"$tmp/wts"
	while IFS="$(printf '\t')" read -r path branch; do
		[ -n "$branch" ] && echo "$branch" >>"$tmp/out"
		[ -d "$path" ] || { echo "prune $path (gone)"; continue; }
		[ -n "$branch" ] || continue
		[ "$(stale_reason "$branch" "$(g rev-parse "$branch")")" = "pr" ] || continue
		why=$(blocked "$path")
		if [ -n "$why" ]; then
			echo "keep worktree $path: $why"
		else
			printf '%s\t%s\n' "$path" "$branch" >>"$tmp/retire"
			echo "retire $path [$branch: pr]"
		fi
	done <"$tmp/wts"
	# Branches not checked out anywhere; a retired worktree's branch is deleted after it goes.
	: >"$tmp/delete"
	kept=0
	for ref in $(g for-each-ref --format='%(refname:short)' refs/heads); do
		[ "$ref" = main ] && continue
		reason=$(stale_reason "$ref" "$(g rev-parse "$ref")")
		if [ -z "$reason" ]; then
			kept=$((kept + 1))
		elif ! grep -qxF "$ref" "$tmp/out"; then
			echo "$ref" >>"$tmp/delete"
			echo "delete $ref ($reason)"
		fi
	done
	echo "$(wc -l <"$tmp/retire" | tr -d ' ') worktrees, $(wc -l <"$tmp/delete" | tr -d ' ') branches; $kept kept (open PR or local-only commits)"
	if [ -z "$execute" ]; then
		echo "dry run; ./dev clean --execute to do it"
		return
	fi
	g worktree prune
	while IFS="$(printf '\t')" read -r path branch; do
		# Refuses a worktree with uncommitted or untracked files; the branch then stays.
		if g worktree remove "$path"; then
			echo "$branch" >>"$tmp/delete"
		else
			echo "dev: could not remove $path, keeping $branch" >&2
		fi
	done <"$tmp/retire"
	# Prints `Deleted branch x (was <sha>)`; `git branch x <sha>` restores one.
	[ -s "$tmp/delete" ] && g branch -D $(cat "$tmp/delete")
	return 0
}

case "${1:-}" in
	ls) shift; cmd_ls "$@" ;;
	clean) shift; cmd_clean "$@" ;;
	*) sed -n '2,7s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
