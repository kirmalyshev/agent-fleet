#!/bin/sh
# Developer helpers for this repository.
#
#   ./dev ls               every worktree of this repo: branch, PR, commits not in main,
#                          uncommitted files, and what clean would do with it
#   ./dev clean            what clean would retire and delete (a dry run)
#   ./dev clean --execute  retire finished worktrees and delete finished local branches
#
# Both are `agent-fleet worktree ls|clean` for this repository, built from this checkout; its
# --help has the rules. `AGENT_FLEET_GH` names the gh binary.
set -eu
case "${1:-}" in
	ls | clean) ;;
	*) sed -n '2,7s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
exec cargo run -q --manifest-path "$(dirname "$0")/Cargo.toml" -- \
	worktree "$@" --repo kirmalyshev/agent-fleet
